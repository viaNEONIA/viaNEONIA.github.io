---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props as { project: Project };
---
<BaseLayout title={project.name} description={project.description}>
  <nav class="breadcrumbs" aria-label="パンくずリスト">
    <a href="/">ホーム</a><span aria-hidden="true">/</span>
    <a href="/projects/">プロジェクト</a><span aria-hidden="true">/</span>
    <span aria-current="page">{project.name}</span>
  </nav>
  <article class="project-detail">
    <p class="eyebrow">{project.category} · {project.status}</p>
    <h1>{project.name}</h1>
    <p class="project-lead">{project.description}</p>
    {project.slug === 'android-memo' && (
      <section aria-labelledby="memo-ui-heading" class="memo-ui-showcase">
        <h2 id="memo-ui-heading">UI紹介・画面イメージ</h2>
        <p class="muted">ホーム、編集、長押しメニュー、共有登録の操作画面をまとめた紹介画像です。個人のメモ内容はぼかしてあります。実装状況はGitHubをご確認ください。</p>
        <a href="/images/projects/android-memo/ui-overview.png" target="_blank" rel="noopener noreferrer" aria-label="統合メモのUI紹介画像を拡大して開く">
          <img src="/images/projects/android-memo/ui-overview.png" alt="統合メモのホーム一覧、メモ編集、長押しメニュー、共有登録の4画面を紹介した画像。個人のメモ内容はぼかし加工済み。" loading="lazy" decoding="async" width="1169" height="1279" class="memo-ui-poster" />
        </a>
        <p class="muted">※ 開発中のUI紹介画像です。画面構成や機能は変更される場合があります。</p>
      </section>
    )}
    {project.slug === 'android-memo' && (
      <section aria-labelledby="memo-features-heading" class="memo-feature-showcase">
        <h2 id="memo-features-heading">主な機能・最新アップデート</h2>
        <p class="muted">開発版 0.7.0-dev。2026年11月8日までの実装情報をもとに掲載しています。</p>
        <div class="memo-feature-grid">
          {[
            { title: 'リーディングモード', description: 'Mozilla Readabilityで公開Web記事の本文を抽出。読みやすい全画面表示で閲覧できます。' },
            { title: 'ループスクロール', description: '通常一覧・ピン留め・アーカイブ・タグフォルダで、先頭と末尾をつないで移動できます。余白がある場合は下寄せ表示になります。' },
            { title: 'スクロール振動', description: '1行分のスクロールで振動。設定からオフ・弱・中・強を選択できます。' },
            { title: 'タグ別フォルダ', description: 'タグごとにメモを分類し、フォルダ内の件数を表示。最近使ったタグの候補も表示します。' },
            { title: '自動タグ付け', description: 'URLの入力で「web」、店名の入力で「買い物」を保存時に自動追加します。' },
            { title: 'ピン留め・手動並び替え', description: '長押しメニューから上下移動し、希望する行で固定。ピン留め専用一覧も利用できます。' },
            { title: '共有から登録', description: 'Androidの共有メニューからURL・テキスト・画像・ファイルを取り込み、メモやタグを付けて保存します。' },
            { title: 'サイトアイコン', description: 'HTTPSサイトのアイコンを取得し、端末内にキャッシュ。取得済みのアイコンはオフラインでも利用できます。' },
            { title: 'アーカイブ・バックアップ', description: 'メモを削除せずに整理。JSONの書き出し・追加復元に対応します。添付本体やピン位置はバックアップ対象外です。' }
          ].map((feature) => (
            <article class="memo-feature">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
        <p class="muted">検証状況：ビルド・単体試験33件は成功。最新版の実機確認は未完了です。記事本文の取得や外部サイト閲覧には通信が必要です。</p>
      </section>
    )}
    <section aria-labelledby="links-heading">
      <h2 id="links-heading">関連リンク</h2>
      <div class="detail-actions">
        {project.app && <a class="button" href={project.app}>アプリを開く</a>}
        <a class="button button-secondary" href={project.repository}>GitHubでソースを見る</a>
      </div>
    </section>
    <section aria-labelledby="about-heading">
      <h2 id="about-heading">プロジェクトについて</h2>
      <p>{project.description}</p>
      <p class="muted">開発状況や詳細な変更履歴はGitHubリポジトリで確認できます。</p>
    </section>
  </article>
  <p><a href="/projects/">← プロジェクト一覧へ戻る</a></p>
</BaseLayout>
