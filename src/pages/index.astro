---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
const featured = projects.filter((project) => project.featured);
---
<BaseLayout title="ホーム">
  <section class="hero">
    <p class="eyebrow">INDEPENDENT SOFTWARE DEVELOPMENT</p>
    <h1>アイデアを、使えるソフトウェアへ。</h1>
    <p>Webアプリ・PWA・DayZ MODなどの開発プロジェクトを紹介しています。</p>
    <a class="button" href="/projects/">すべてのプロジェクトを見る</a>
  </section>
  <section aria-labelledby="featured-heading">
    <div class="section-heading"><h2 id="featured-heading">Featured projects</h2><a href="/projects/">一覧を見る</a></div>
    <div class="cards">
      {featured.map((project) => <article class="card">
        <span class="category">{project.category}</span>
        <h3>{project.name}</h3>
        <p class="muted">{project.description}</p>
        <div class="card-links">
          {project.app && <a href={project.app}>アプリを開く</a>}
          <a href={project.repository}>GitHub</a>
        </div>
      </article>)}
    </div>
  </section>
</BaseLayout>
